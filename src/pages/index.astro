---
import ContactCta from '../components/ContactCta.astro';
import Hero from '../components/Hero.astro';
import Row from '../components/Row.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TextLink from '../components/TextLink.astro';
import { services } from '../data/services';
import { home } from '../data/site';
import Base from '../layouts/Base.astro';
---

<Base title={home.title} description={home.description}>
  <Hero />

  <section class="pb-10">
    <SectionLabel>{home.servicesLabel}</SectionLabel>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s) => <ServiceCard slug={s.slug} id={s.id} title={s.title} text={s.summary} />)}
    </ul>
  </section>

  <section class="pb-10">
    <SectionLabel>{home.workLabel}</SectionLabel>
    <ul class="border-b border-line">
      {home.work.map((row) => <Row {...row} />)}
    </ul>
    <TextLink href={home.workLink.href} class="mt-2 font-mono text-sm">
      {home.workLink.label}&nbsp;<span aria-hidden="true">&rarr;</span>
    </TextLink>
  </section>

  <ContactCta />
</Base>
