---
import PageHeader from '../components/PageHeader.astro';
import TextLink from '../components/TextLink.astro';
import { notFound } from '../data/site';
import Base from '../layouts/Base.astro';
---

<Base title={notFound.title} description={notFound.description} noindex>
  <PageHeader label={notFound.label} heading={notFound.heading} lede={notFound.lede} />
  <p class="pb-16 font-mono text-sm">
    <TextLink href={notFound.link.href}>{notFound.link.label}</TextLink>
  </p>
</Base>
