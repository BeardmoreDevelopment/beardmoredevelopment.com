---
import BulletList from '../../components/BulletList.astro';
import ContactCta from '../../components/ContactCta.astro';
import PageHeader from '../../components/PageHeader.astro';
import Row from '../../components/Row.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import TextLink from '../../components/TextLink.astro';
import { services, servicesPage } from '../../data/services';
import { site } from '../../data/site';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return services.map((service, i) => ({
    params: { slug: service.slug },
    props: { service, prev: services[i - 1], next: services[i + 1] },
  }));
}

const { service, prev, next } = Astro.props;
const { labels } = servicesPage;
---

<Base title={`${service.title} | ${site.name}`} description={service.summary}>
  <p class="-mb-6 pt-8 font-mono text-sm">
    <TextLink href="/services/">
      <span aria-hidden="true">&larr;&nbsp;</span>
      {labels.back}
    </TextLink>
  </p>
  <PageHeader label={`// ${service.id}`} heading={service.title} lede={service.summary} />

  <section class="pb-10">
    <SectionLabel>{labels.intro}</SectionLabel>
    <div class="max-w-3xl space-y-4 text-body">
      {service.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="pb-10">
    <SectionLabel>{labels.needs}</SectionLabel>
    <BulletList items={service.needs} />
  </section>

  <section class="pb-10">
    <SectionLabel>{labels.deliverables}</SectionLabel>
    <BulletList items={service.deliverables} />
  </section>

  <section class="pb-10">
    <SectionLabel>{labels.evidence}</SectionLabel>
    <ul class="border-b border-line">
      {service.evidence.map((row) => <Row {...row} />)}
    </ul>
  </section>

  <nav aria-label={labels.pager} class="flex flex-col justify-between gap-x-6 pb-10 font-mono text-sm sm:flex-row">
    {
      prev ? (
        <TextLink href={`/services/${prev.slug}/`}>
          <span aria-hidden="true">&larr;&nbsp;</span>
          {`${prev.id} ${prev.title}`}
        </TextLink>
      ) : (
        <span />
      )
    }
    <TextLink href="/services/">
      <span aria-hidden="true">&larr;&nbsp;</span>
      {labels.back}
    </TextLink>
    {
      next && (
        <TextLink href={`/services/${next.slug}/`}>
          {`${next.id} ${next.title}`}
          <span aria-hidden="true">&nbsp;&rarr;</span>
        </TextLink>
      )
    }
  </nav>

  <ContactCta />
</Base>
