---
import { site } from '../data/site';
import EmailButton from './EmailButton.astro';
import SectionLabel from './SectionLabel.astro';
---

<section id="contact" class="pb-16">
  <SectionLabel>{site.contact.label}</SectionLabel>
  <p class="text-lg text-ink">{site.contact.availability}</p>
  <p class="mt-1 mb-5 font-mono text-sm text-muted">{site.contact.location}</p>
  <div class="flex flex-col items-start gap-x-5 gap-y-2 sm:flex-row sm:items-center">
    <EmailButton />
    <a
      href={`mailto:${site.email}`}
      class="inline-flex min-h-11 items-center font-mono text-xs break-all sm:text-sm text-body underline underline-offset-4 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-linework"
    >
      {site.email}
    </a>
  </div>
</section>
