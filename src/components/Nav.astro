---
import { site } from '../data/site';
---

<header class="border-b border-line">
  <nav
    aria-label="Main"
    class="mx-auto flex max-w-5xl flex-col px-4 py-2 font-mono text-sm sm:flex-row sm:items-center sm:justify-between sm:px-8"
  >
    <a
      href="#top"
      class="inline-flex min-h-11 items-center self-start font-bold text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-linework"
    >
      {site.wordmark}
    </a>
    <ul class="flex gap-6 text-muted">
      {
        site.nav.map((link) => (
          <li>
            <a
              href={link.href}
              class="inline-flex min-h-11 items-center hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-linework"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
