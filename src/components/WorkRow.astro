---
interface Props {
  employer: string;
  text: string;
}

const { employer, text } = Astro.props;
---

<li class="flex flex-col gap-1 border-t border-line py-3 sm:flex-row sm:gap-4">
  <span class="shrink-0 font-mono text-sm text-muted sm:w-44">{employer}</span>
  <span class="text-body">{text}</span>
</li>
